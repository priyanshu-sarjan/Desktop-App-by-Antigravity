{
  "name": "cipherschools-desktop",
  "version": "1.0.0",
  "description": "A desktop wrapper for CipherSchools built with Electron",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "author": "Priyanshu",
  "license": "ISC",
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
